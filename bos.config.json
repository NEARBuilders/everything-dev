      "routes": ["ui/src/routes/_layout/_authenticated/settings.tsx"],
      "sidebar": [
        {
          "icon": "Settings",
          "label": "settings"
        }
      ]
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-3601-host-everything-dev-nearbuilder-bf98aa005-ze.zephyrcloud.app",
