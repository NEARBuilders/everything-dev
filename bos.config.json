{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-5498-host-everything-dev-nearbuilder-31dca8caf-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ]
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-5493-ui-everything-dev-nearbuilders-aa506b895-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-5494-ui-everything-dev-nearbuilders-0bcf7b709-ze.zephyrcloud.app",
      "integrity": "sha384-O7vtFOQMnRG1vaU0sfaegNESKJwoE/lz9zwRYsqswtTUISws8yiB4OrnMTBIylGA",
      "ssrIntegrity": "sha384-FSoe/w+wmQa2gRXQM651zQC7M7fGzsYZoN3tY9PSp/RjUuVwYSJCjkh04vEhTHCI"
    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-5495-api-everything-dev-nearbuilders-ee055f037-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ],
      "integrity": "sha384-w4pCKJt6XuXd0q71wH/Q82y7VvyPChAIph8D+QfKIKs/ya5pYxfKc9EW9stvdylm"
    },
    "auth": {
      "extends": "bos://auth.everything.near/auth.everything.dev",
      "variables": {
        "passkey": {
          "rpID": "everything.dev",
          "rpName": "everything.dev"
        },
        "siwn": {
          "recipients": {
            "mainnet": "dev.everything.near",
            "testnet": "dev.allthethings.testnet"
          }
        }
      }
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-5496-everything-dev-apps-plugin-ever-b275b89c9-ze.zephyrcloud.app",
      "variables": {
        "registryNamespace": "dev.everything.near"
      },
      "routes": [
        "ui/src/routes/_layout/apps/**",
        "ui/src/routes/_layout/index.tsx"
      ],
      "sidebar": [
        {
          "icon": "Globe",
          "label": "apps",
          "roleRequired": "anon"
        }
      ],
      "integrity": "sha384-wKXTvWAAHvluWG8DUBYgY70C/AFq6ey5dJSAdXWJrqCHs+YI4/LvmWpvTM7ri5cT"
    },
    "template": {
      "development": "local:plugins/_template",
      "production": "https://elliot-braem-5497-every-plugin-template-everythin-19f39ecb7-ze.zephyrcloud.app",
      "integrity": "sha384-cMHoFzqsnu6pKdzo1E1EVS2uz83rKmZRVF2nc8JFDWgQyWcipwIj0Bp59Nh1n12W"
    }
  }
}
