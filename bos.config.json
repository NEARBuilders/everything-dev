      "integrity": "sha384-HGCj8X8OaADQo1cBP6gyaTEdaGpEqO7EWWlpdp/3Xx4LyM/uVHmLfXTTgdl3NZ9S",
      "shared": {
        "better-auth": {
          "version": "1.6.9",
          "requiredVersion": "^1.6.9",
          "singleton": true,
          "strictVersion": false,
          "shareScope": "default"
        },
        "better-near-auth": {
          "version": "1.5.0",
          "requiredVersion": "^1.5.0",
          "singleton": true,
          "strictVersion": false,
          "shareScope": "default"
        },
        "@better-auth/api-key": {
          "version": "1.6.9",
          "requiredVersion": "^1.6.9",
          "singleton": true,
          "strictVersion": false,
          "shareScope": "default"
        },
        "@better-auth/passkey": {
          "version": "1.6.9",
          "requiredVersion": "^1.6.9",
          "singleton": true,
          "strictVersion": false,
          "shareScope": "default"
        }
      },
      "variables": {
        "baseUrl": "https://auth.everything.near",
        "trustedOrigins": [
          "https://everything.dev",
          "https://*.everything.dev"
        ],
        "socialProviders": {
          "github": {
            "clientId": ""
