{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-6618-host-everything-dev-nearbuilder-464eaa994-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ]
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-6613-ui-everything-dev-nearbuilders-0d3421bc1-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-6617-ui-everything-dev-nearbuilders-965d6eb32-ze.zephyrcloud.app",
      "integrity": "sha384-yHWzcadQqHul3GO8XW0G6KjsoptXH+jMUho8x0UmjAXK1UNjkjKQNDjgf4PcsKqE",
      "ssrIntegrity": "sha384-2si/7cYm/ptrIs+4zCYvv5TH/hydPS5ahw7dFO7xpuSkX378rS5kf4aEvsAs7UDz"
    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-6616-api-everything-dev-nearbuilders-a93f550d3-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ],
      "integrity": "sha384-n4/4H5TaEIut8flawMGliykGk0apiwE3AUQt5APm3PDQTHIBV2NhEi3OKNkKpsDv"
    },
    "auth": {
      "extends": "bos://auth.everything.near/auth.everything.dev#app.auth",
      "variables": {
        "passkey": {
          "rpID": "everything.dev",
          "rpName": "everything.dev"
        },
        "siwn": {
          "recipients": {
            "mainnet": "dev.everything.near",
            "testnet": "dev.allthethings.testnet"
          }
        }
      }
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-6615-everything-dev-apps-plugin-ever-b6136566e-ze.zephyrcloud.app",
      "variables": {
        "registryNamespace": "dev.everything.near"
      },
      "routes": [
        "ui/src/routes/_layout/apps/**"
      ],
      "integrity": "sha384-YWhPTyc/wQYkMhrlFnAqXASLKciWy/Wz7Su+2jUYynvmsF0Dix0NyCsvIMSuizoE"
    },
    "template": {
      "development": "local:plugins/_template",
      "production": "https://elliot-braem-6614-every-plugin-template-everythin-b38340992-ze.zephyrcloud.app",
      "integrity": "sha384-GYxfyoYBln8D+keAEdfH10BfPp0T/FFGRYjsHX/GSb71TN5vyp2b0L43Ngyx16NU"
    }
  }
}
