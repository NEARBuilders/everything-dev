{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-7431-host-everything-dev-nearbuilder-27b9b3d9d-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ],
      "integrity": "sha384-XDirkyVnVTW0xaAoGeWS2YtjzvHsBmWgSBLDxqROLAMZbq2gyxrUKjd+K2ixqB6H"
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-7426-ui-everything-dev-nearbuilders-3c312f82c-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-7430-ui-everything-dev-nearbuilders-a7e526d68-ze.zephyrcloud.app",
      "integrity": "sha384-Px7RaJw6XF5/DtNxM5efGxF6voOjJxWm5ly6tG16ECWcc2eYM6SIXryP/KOOp4Ho",
      "ssrIntegrity": "sha384-+L5gUWnjDhP7bKyKQ6e8JNDpGOSUu0E9Z7UiFfRgm7WdZj6FK39zRiq4T2WIhY23"
    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-7429-api-everything-dev-nearbuilders-0015a0f03-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ],
      "integrity": "sha384-g5kMC6dA5l7l9NBq2U5yWgntreOEqT4+ifIH7a6RMC2JSj6tIuGPG6Xq3ZIAPUAi"
    },
    "auth": {
      "extends": "bos://auth.everything.near/auth.everything.dev#app.auth",
      "secrets": [
        "NEAR_SUB_ACCOUNT_PARENT_KEY_MAINNET",
        "NEAR_SUB_ACCOUNT_PARENT_KEY_TESTNET"
      ],
      "variables": {
        "passkey": {
          "rpID": "everything.dev",
          "rpName": "everything.dev"
        },
        "siwn": {
          "recipients": {
            "mainnet": "dev.everything.near",
            "testnet": "dev.allthethings.testnet"
          },
          "subAccount": {
            "mainnet": {
              "parentAccount": "dev.everything.near",
              "parentHasFullAccess": true,
              "minDeposit": "0.1 NEAR"
            },
            "testnet": {
              "parentAccount": "dev.allthethings.testnet",
              "parentHasFullAccess": true,
              "minDeposit": "0.1 NEAR"
            }
          }
        }
      }
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-7428-everything-dev-apps-plugin-ever-d486f8e30-ze.zephyrcloud.app",
      "variables": {
        "registryNamespace": "dev.everything.near"
      },
      "routes": [
        "ui/src/routes/_layout/apps/**"
      ],
      "integrity": "sha384-ehJsiIaaGQb5NjyNKWKS1+4ct479UK+n7MGaB6ZVdOsPSZd7hklMLZcIX5EkXECK"
    },
    "template": {
      "development": "local:plugins/_template",
      "production": "https://elliot-braem-7427-every-plugin-template-everythin-7a18ac30e-ze.zephyrcloud.app",
      "secrets": [
        "TEMPLATE_DATABASE_URL"
      ],
      "integrity": "sha384-7LAf3x/t4S0nQI0l0rtuvPzpJC81tAHljZOpa1Bc3Lr5pma9jEaM/eClDCvWpnVK"
    }
  }
}
