    "ui": {
      "effect": {
        "version": "3.21.0",
        "requiredVersion": "^3.21.0",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      },
      "zod": {
        "version": "4.3.6",
        "requiredVersion": "^4.3.6",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      },
      "@orpc/contract": {
        "version": "1.13.14",
        "requiredVersion": "^1.13.14",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      },
      "better-auth": {
        "version": "1.6.9",
        "requiredVersion": "^1.6.9",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      },
      "better-near-auth": {
        "version": "1.4.0",
        "requiredVersion": "^1.4.0",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      },
      "@better-auth/api-key": {
        "version": "1.6.9",
        "requiredVersion": "^1.6.9",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      },
      "@better-auth/passkey": {
        "version": "1.6.9",
        "requiredVersion": "^1.6.9",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      }
    },
    "plugins": {}
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-3749-everything-dev-apps-plugin-ever-23fc667ce-ze.zephyrcloud.app",
      "integrity": "sha384-aLxzIq4w+mfjVeW4WYVteMNncUnN6fBSm5PNPuoiw3wL+8GFm2KvBeeisQ2Cb94b",
      "variables": {
        "registryNamespace": "dev.everything.near"
