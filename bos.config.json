{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-4052-host-everything-dev-nearbuilder-55be32a36-ze.zephyrcloud.app",
      "integrity": "sha384-VePB/4eD30TF7NdAvE77Osb/PxXlD1w1hlq5/Lg0RQNvtJHzWitrWx3NeE5Gals7",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ]
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-4046-ui-everything-dev-nearbuilders-3bdc80c1d-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-4047-ui-everything-dev-nearbuilders-835145fd7-ze.zephyrcloud.app",
      "integrity": "sha384-NCoP0zJCaRS87lV2gJ1M9zmjpr519hYSwrtPdii0RCaDsqOSSBuB062oqsy/4De6",
      "ssrIntegrity": "sha384-L89MZTh4DIom207yPznV7vt3q3+Iq+OsjTsfMxRZSHg5G9ZRGBPOjtFXN7LJcDuS"
    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-4048-api-everything-dev-nearbuilders-377dfee99-ze.zephyrcloud.app",
      "integrity": "sha384-1QVKgOG2z5Ouz3Ui3Bj4KeGgZfCBJgxWmwv89Yle85EJ3NcD2Q9iYSC/jrKsX/Y7",
      "secrets": [
        "API_DATABASE_URL"
      ]
    },
    "auth": {
      "extends": "bos://auth.everything.near/everything.dev#app.auth"
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-4049-everything-dev-apps-plugin-ever-2d3e13aa4-ze.zephyrcloud.app",
      "integrity": "sha384-HxmWBkKKPYgtN3s0/2qAlXMThQbp0Al/KcaS1OxabGtGevjMzOIZARm+YnHTIUPd",
      "variables": {
        "registryNamespace": "dev.everything.near"
      },
      "routes": [
        "ui/src/routes/_layout/apps/**",
        "ui/src/routes/_layout/index.tsx"
      ],
      "sidebar": [
        {
          "icon": "Globe",
          "label": "apps",
          "roleRequired": "anon"
        }
      ]
    },
    "projects": {
      "development": "local:plugins/projects",
      "production": "https://elliot-braem-4050-everything-dev-projects-plugin--e5b9e107e-ze.zephyrcloud.app",
      "integrity": "sha384-HbSmv7VBbuGtpfpRQHvx40VSoPIJw81bMIwnd+6jX3U9PpyAMhlhS2eRHQKXxU0y",
      "secrets": [
        "PROJECTS_DATABASE_URL"
      ],
      "routes": [
        "ui/src/routes/_layout/_authenticated/projects/**"
      ],
      "sidebar": [
        {
          "icon": "FolderKanban",
          "label": "projects"
        }
      ]
    },
    "settings": {
      "development": "local:plugins/settings",
      "production": "https://elliot-braem-4051-every-plugin-settings-everythin-a348f9a23-ze.zephyrcloud.app",
      "integrity": "sha384-VQHIcTRu11j/TD6w0mAkbKKcxgqUuofVzlXD2xgsksXo4lRLCAPPrQAuLKCxej1q",
      "routes": [
        "ui/src/routes/_layout/_authenticated/settings.tsx"
      ],
      "sidebar": [
        {
          "icon": "Settings",
          "label": "settings"
        }
      ]
    }
  },
  "shared": {
    "ui": {
      "effect": {
        "version": "3.21.2",
        "requiredVersion": "^3.21.2",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
