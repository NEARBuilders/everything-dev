{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-4610-host-everything-dev-nearbuilder-95a126acf-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ],
      "integrity": "sha384-sPBsGgHNp0G4EVin2liiaWIOtpRngnNpah6TFTGBQSfxgC4oStg/0ahr9v2PKoBM"
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-4604-ui-everything-dev-nearbuilders-6d7a47a5d-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-4605-ui-everything-dev-nearbuilders-c46fd7fa1-ze.zephyrcloud.app",
      "integrity": "sha384-Q6NV17geKB63o2ARyC73WKCPeLJfNvKKmi5oMPHAXAmvCywRLqoY1c5sq5a8abTk",
      "ssrIntegrity": "sha384-8cGvxO5R4TrGiXAet5Hyshhli6cko0wWgTkFw1tn3X/SOqos9Hu9W0ef3K115Vwa"
    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-4606-api-everything-dev-nearbuilders-fe2eede1a-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ]
    },
    "auth": {
      "name": "everything-dev_auth-plugin",
      "development": "local:plugins/auth",
      "production": "https://elliot-braem-4596-everything-dev-auth-plugin-bett-5c7464d90-ze.zephyrcloud.app",
      "integrity": "sha384-hdiTtgW15RyAVkpNdgNxQxKP3xOkMs2jJ27O53l1zEi++nghcPFn8QZQb9avuLMe",
      "variables": {
        "passkey": {
          "rpID": "everything.dev",
          "rpName": "Better NEAR Auth"
        },
        "siwn": {
          "recipients": {
            "mainnet": "auth.everything.near",
            "testnet": "dev.allthethings.testnet"
          }
        }
      },
      "secrets": [
        "AUTH_DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "GITHUB_CLIENT_SECRET",
        "FASTNEAR_API_KEY",
        "TWILIO_ACCOUNT_SID",
        "TWILIO_AUTH_TOKEN",
        "TWILIO_PHONE_NUMBER",
        "NEAR_RELAYER_PRIVATE_KEY",
        "NEAR_SUB_ACCOUNT_PARENT_KEY_MAINNET",
        "NEAR_SUB_ACCOUNT_PARENT_KEY_TESTNET"
      ],
      "shared": {
        "better-auth": {
          "version": "1.6.9",
          "requiredVersion": "^1.6.9",
          "singleton": true,
          "strictVersion": false,
          "shareScope": "default"
        },
        "better-near-auth": {
          "version": "1.6.1",
          "requiredVersion": "^1.5.0",
          "singleton": true,
          "strictVersion": false,
          "shareScope": "default"
        },
        "@better-auth/api-key": {
          "version": "1.6.9",
          "requiredVersion": "^1.6.9",
          "singleton": true,
          "strictVersion": false,
          "shareScope": "default"
        },
        "@better-auth/passkey": {
          "version": "1.6.9",
          "requiredVersion": "^1.6.9",
          "singleton": true,
          "strictVersion": false,
          "shareScope": "default"
        }
      }
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-4607-everything-dev-apps-plugin-ever-0b2cd03e3-ze.zephyrcloud.app",
      "variables": {
        "registryNamespace": "dev.everything.near"
      },
      "routes": [
        "ui/src/routes/_layout/apps/**",
        "ui/src/routes/_layout/index.tsx"
      ],
      "sidebar": [
        {
          "icon": "Globe",
          "label": "apps",
          "roleRequired": "anon"
        }
      ],
      "integrity": "sha384-QxCKAgSiBmfo+1IT8/ZUehcwRhKYo3Vzqf3B/Yiii1ENakvZlaKf3wIj9sRQGFTa"
    },
    "projects": {
      "development": "local:plugins/projects",
      "production": "https://elliot-braem-4608-everything-dev-projects-plugin--88b81a54d-ze.zephyrcloud.app",
      "secrets": [
        "PROJECTS_DATABASE_URL"
      ],
      "routes": [
        "ui/src/routes/_layout/_authenticated/projects/**"
      ],
      "sidebar": [
        {
          "icon": "FolderKanban",
          "label": "projects"
        }
      ],
      "integrity": "sha384-5jLoaFFPn+xEAHEElnxCSswA8C7mkwy5eEVX37lbKFYYgl7TitqmMW8l0Xc2+WgV"
    },
    "settings": {
      "development": "local:plugins/settings",
      "production": "https://elliot-braem-4609-every-plugin-settings-everythin-ba68d0853-ze.zephyrcloud.app",
      "routes": [
        "ui/src/routes/_layout/_authenticated/settings.tsx"
      ],
      "sidebar": [
        {
          "icon": "Settings",
          "label": "settings"
        }
      ]
    }
  }
}
