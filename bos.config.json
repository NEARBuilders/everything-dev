      "ssr": "https://elliot-braem-4588-ui-everything-dev-nearbuilders-850222d91-ze.zephyrcloud.app",
      "integrity": "sha384-0GCTPyeL1iik1t+WqGC2qdu3ln5ofcm0BYO0uqtv1Ank/dKtyHFHwFGU8HJJghWr",
