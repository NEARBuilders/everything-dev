      "integrity": "sha384-f/HuutBh3+h3xiBvJvJu4HDAp2jhSLDR0OLjSjhLjg595qGOQLBu2oYO/u+vjdzq",
      "secrets": [
        "API_DATABASE_URL"
      ]
    },
    "auth": {
      "extends": "bos://auth.everything.near/everything.dev#app.auth"
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-3979-everything-dev-apps-plugin-ever-c59643b12-ze.zephyrcloud.app",
      "integrity": "sha384-fGQEg7G+Ze38bNMMrhVboO/vbz9WHISeG0nhHuSQki4Xu5ZpKwu1EwXFFRAc9QUy",
      "variables": {
