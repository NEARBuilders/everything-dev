{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "testnet": "dev.allthethings.testnet",
  "staging": {
    "domain": "staging.dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-3982-host-everything-dev-nearbuilder-ce31237a5-ze.zephyrcloud.app",
      "integrity": "sha384-xpMal1DC+V2vazkrYCJspPT6XldFXbd0bcd1Qq9lc6mVcaLLy9PWQLpDbuxxoVSs",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ]
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-3976-ui-everything-dev-nearbuilders-dd42b658b-ze.zephyrcloud.app",
