      "development": "local:host",
      "production": "https://elliot-braem-5760-host-everything-dev-nearbuilder-eab452c3f-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ],
      "integrity": "sha384-N6UNwGCUJ2d02QUJjXXSZRH5aExTe/TzVkEUiRXUn33BKQ5OCliysMGYb0ToJhHp"
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-5755-ui-everything-dev-nearbuilders-00ed90ab3-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-5759-ui-everything-dev-nearbuilders-920b006d0-ze.zephyrcloud.app",
      "integrity": "sha384-5iv0aB87QKy+iZ6gLphfuzhG6P+QypBodRpIyM4oDYwEexNg4agEa+EXfJtYcwLu",
