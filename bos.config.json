    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-5758-api-everything-dev-nearbuilders-d0bff44ca-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ],
      "integrity": "sha384-/qapybWiJCi/h2pKo2mRDxKYTGcLv9lgyB8XN7J9X+QJ+i/7wDFFMfw8hYp/nzKt"
    },
    "auth": {
      "extends": "bos://auth.everything.near/auth.everything.dev#app.auth",
      "variables": {
        "passkey": {
          "rpID": "everything.dev",
          "rpName": "everything.dev"
        },
        "siwn": {
          "recipients": {
            "mainnet": "dev.everything.near",
            "testnet": "dev.allthethings.testnet"
          }
        }
      }
    }
  },
  "plugins": {
