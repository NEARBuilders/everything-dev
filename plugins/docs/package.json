{
  "name": "@everything-dev/docs-plugin",
  "version": "0.1.0-rc.0",
  "description": "Docs plugin — docs-as-code over the repository's markdown, compiled at build time by velite",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contract": {
      "types": "./src/contract.ts",
      "default": "./src/contract.ts"
    }
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "dependencies": {
    "@orpc/contract": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "cn": "^0.4.0",
    "effect": "catalog:",
    "every-plugin": "workspace:^",
    "everything-dev": "workspace:^",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@module-federation/enhanced": "catalog:",
    "@module-federation/node": "catalog:",
    "@module-federation/rsbuild-plugin": "catalog:",
    "@module-federation/runtime-tools": "catalog:",
    "@rsbuild/core": "catalog:",
    "@rsbuild/plugin-react": "catalog:",
    "@rspack/cli": "catalog:",
    "@rspack/core": "catalog:",
    "@tailwindcss/postcss": "^4.1.17",
    "@tanstack/router-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "dotenv": "^17.2.3",
    "everything-dev": "workspace:^",
    "every-plugin": "workspace:^",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "velite": "^0.4.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "every-plugin build",
    "dev": "every-plugin dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "velite && tsc --noEmit",
    "typecheck:ui": "tsc --noEmit -p ui/tsconfig.json"
  }
}
