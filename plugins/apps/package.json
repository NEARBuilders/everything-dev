{
  "name": "@everything-dev/apps-plugin",
  "version": "1.4.2",
  "description": "Apps plugin for discovering and publishing apps via NEAR FastKV",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contract": {
      "types": "./src/contract.ts",
      "default": "./src/contract.ts"
    }
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "dependencies": {
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "near-kit": "catalog:",
    "effect": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@module-federation/node": "catalog:",
    "@module-federation/runtime-tools": "catalog:",
    "@rspack/cli": "catalog:",
    "@rspack/core": "catalog:",
    "@types/node": "catalog:",
    "dotenv": "^17.2.3",
    "@proj-airi/unplugin-drizzle-orm-migrations": "^0.1.4",
    "everything-dev": "catalog:",
    "every-plugin": "catalog:",
    "host": "workspace:*",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "every-plugin build",
    "dev": "every-plugin dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  }
}
