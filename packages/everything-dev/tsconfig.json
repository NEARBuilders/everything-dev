{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "customConditions": ["development"],
    "paths": {
      "every-plugin": ["../every-plugin/src/index.ts"],
      "every-plugin/runtime": ["../every-plugin/src/runtime/index.ts"],
      "every-plugin/normalize": ["../every-plugin/src/runtime/services/normalize.ts"],
      "every-plugin/errors": ["../every-plugin/src/errors.ts"],
      "every-plugin/types": ["../every-plugin/src/types.ts"],
      "every-plugin/build/rspack": ["../every-plugin/src/build/rspack/index.ts"],
      "every-plugin/build/artifact-names": ["../every-plugin/src/build/artifact-names.ts"],
      "every-plugin/build/ui": ["../every-plugin/src/build/ui/index.ts"],
      "every-plugin/version-manifest": ["../every-plugin/src/version-manifest.ts"]
    },
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "outDir": "./dist",
    "rootDir": "..",
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "../every-plugin/src/**/*"],
  "exclude": ["node_modules", "dist"]
}
