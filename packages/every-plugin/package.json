    "react": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/zod": "catalog:",
    "@orpc/tanstack-query": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.117",
    "@orpc/client": "2.0.0-beta.35",
    "@orpc/openapi": "2.0.0-beta.35",
    "@rspack/cli": "catalog:",
    "@tanstack/intent": "catalog:",
    "@types/bun": "^1.3.7",
    "@types/node": "^25.1.0",
    "@vitest/ui": "4.1.5",
    "bun-types": "^1.3.7",
    "tsdown": "^0.22.0",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@module-federation/enhanced": "catalog:",
    "@module-federation/node": "catalog:",
    "@module-federation/runtime-core": "catalog:",
    "@module-federation/runtime-tools": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/experimental-effect": "catalog:",
    "@orpc/publisher": "catalog:",
    "@orpc/tanstack-query": "catalog:"
