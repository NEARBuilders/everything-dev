{
  "name": "every-plugin",
  "version": "2.10.1",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "bun": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "development": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./runtime": {
      "bun": {
        "types": "./src/runtime/index.ts",
        "import": "./src/runtime/index.ts"
      },
      "development": {
        "types": "./src/runtime/index.ts",
        "import": "./src/runtime/index.ts"
      },
      "types": "./dist/runtime/index.d.mts",
      "import": "./dist/runtime/index.mjs",
      "require": "./dist/runtime/index.cjs"
    },
    "./testing": {
      "bun": {
        "types": "./src/testing/index.ts",
        "import": "./src/testing/index.ts"
      },
      "development": {
        "types": "./src/testing/index.ts",
        "import": "./src/testing/index.ts"
      },
      "types": "./dist/testing/index.d.mts",
      "import": "./dist/testing/index.mjs",
      "require": "./dist/testing/index.cjs"
    },
    "./normalize": {
      "bun": {
        "types": "./src/runtime/services/normalize.ts",
        "import": "./src/runtime/services/normalize.ts"
      },
      "development": {
        "types": "./src/runtime/services/normalize.ts",
        "import": "./src/runtime/services/normalize.ts"
      },
      "types": "./dist/runtime/services/normalize.d.mts",
      "import": "./dist/runtime/services/normalize.mjs",
      "require": "./dist/runtime/services/normalize.cjs"
    },
    "./errors": {
      "bun": {
        "types": "./src/errors.ts",
        "import": "./src/errors.ts"
      },
      "development": {
        "types": "./src/errors.ts",
        "import": "./src/errors.ts"
      },
      "types": "./dist/errors.d.mts",
      "import": "./dist/errors.mjs",
      "require": "./dist/errors.cjs"
    },
    "./remote-entry": {
      "bun": {
        "types": "./src/remote-entry.ts",
        "import": "./src/remote-entry.ts"
      },
      "development": {
        "types": "./src/remote-entry.ts",
        "import": "./src/remote-entry.ts"
      },
      "types": "./dist/remote-entry.d.mts",
      "import": "./dist/remote-entry.mjs",
      "require": "./dist/remote-entry.cjs"
    },
    "./types": {
      "bun": {
        "types": "./src/types.ts",
        "import": "./src/types.ts"
      },
      "development": {
        "types": "./src/types.ts",
        "import": "./src/types.ts"
      },
      "types": "./dist/types.d.mts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.cjs"
    },
    "./build/rspack": {
      "bun": {
        "types": "./src/build/rspack/index.ts",
        "import": "./src/build/rspack/index.ts"
      },
      "development": {
        "types": "./src/build/rspack/index.ts",
        "import": "./src/build/rspack/index.ts"
      },
      "types": "./dist/build/rspack/index.d.mts",
      "import": "./dist/build/rspack/index.mjs",
      "require": "./dist/build/rspack/index.cjs"
    },
    "./ui/manifest": {
      "bun": {
        "types": "./src/ui/manifest/index.ts",
        "import": "./src/ui/manifest/index.ts"
      },
      "development": {
        "types": "./src/ui/manifest/index.ts",
        "import": "./src/ui/manifest/index.ts"
      },
      "types": {
        "import": "./dist/ui/manifest/index.d.mts",
        "require": "./dist/ui/manifest/index.d.cts"
      },
      "import": "./dist/ui/manifest/index.mjs",
      "require": "./dist/ui/manifest/index.cjs"
    },
    "./ui/manifest-generator": {
      "bun": {
        "types": "./src/ui/manifest/generator.ts",
        "import": "./src/ui/manifest/generator.ts"
      },
      "development": {
        "types": "./src/ui/manifest/generator.ts",
        "import": "./src/ui/manifest/generator.ts"
      },
      "types": {
        "import": "./dist/ui/manifest/generator.d.mts",
        "require": "./dist/ui/manifest/generator.d.cts"
      },
      "import": "./dist/ui/manifest/generator.mjs",
      "require": "./dist/ui/manifest/generator.cjs"
    },
    "./ui/manifest/contract": {
      "bun": {
        "types": "./src/ui/manifest/contract.ts",
        "import": "./src/ui/manifest/contract.ts"
      },
      "development": {
        "types": "./src/ui/manifest/contract.ts",
        "import": "./src/ui/manifest/contract.ts"
      },
      "types": {
        "import": "./dist/ui/manifest/contract.d.mts",
        "require": "./dist/ui/manifest/contract.d.cts"
      },
      "import": "./dist/ui/manifest/contract.mjs",
      "require": "./dist/ui/manifest/contract.cjs"
    },
    "./build/ui": {
      "bun": {
        "types": "./src/build/ui/index.ts",
        "import": "./src/build/ui/index.ts"
      },
      "development": {
        "types": "./src/build/ui/index.ts",
        "import": "./src/build/ui/index.ts"
      },
      "types": "./dist/build/ui/index.d.mts",
      "import": "./dist/build/ui/index.mjs",
      "require": "./dist/build/ui/index.cjs"
    },
    "./dev-serve": {
      "bun": {
        "types": "./src/dev/serve.ts",
        "import": "./src/dev/serve.ts"
      },
      "development": {
        "types": "./src/dev/serve.ts",
        "import": "./src/dev/serve.ts"
      },
      "types": "./dist/serve.d.mts",
      "import": "./dist/serve.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "every-plugin": "./bin/every-plugin.mjs",
    "every-plugin-serve": "./bin/every-plugin-serve.mjs"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "skills",
    "!skills/_artifacts"
  ],
  "scripts": {
    "build": "tsdown",
    "build:test": "cd tests/fixtures/test-plugin && bun run build",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "bun run build:test && vitest run --config vitest.integration.config.ts",
    "test:all": "bun run test:unit && bun run test:integration",
    "test:watch": "vitest --config vitest.config.ts --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@rspack/core": "catalog:",
    "@proj-airi/unplugin-drizzle-orm-migrations": "*",
    "typescript": "^7.0.2",
    "effect": "catalog:",
    "zod": "catalog:",
