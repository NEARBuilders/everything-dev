# FRAMEWORK-OWNED — reconciled from the parent template by `bos upgrade`.
# Local edits are allowed: on the next upgrade the template version wins and your
# copy is backed up under `.bos/sync-backup/`. To make a change permanent, file an
# issue: https://github.com/NEARBuilders/everything-dev/issues

# Generated from configured bos secrets
# Update values as needed for your local environment

# app.host
CORS_ORIGIN=http://localhost:3000

# app.api
# Leave empty for the per-workspace PGlite default (.bos/db/<slug>); set a postgres:// URL for production or shared access.
API_DATABASE_URL=
BETTER_AUTH_SECRET=

# app.auth
# Leave empty for the per-workspace PGlite default (.bos/db/<slug>); set a postgres:// URL for production or shared access.
AUTH_DATABASE_URL=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET=
FASTNEAR_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=
AUTH_BOOTSTRAP_ADMIN_API_KEY=

# plugins.ai
AI_API_KEY=

# plugins.agent-connect
NEAR_INTENTS_AGENT_API_KEY=
AGENT_CONNECT_ENCRYPTION_KEY=

# Operator flags (optional — read from the environment, empty keeps the default)
# 1 holds a UI adoption when the published generation also moves a boot-frozen backend (api, auth, plugin backends), so UI and backends move as one unit. Default off.
BOS_HOLD_ON_BACKEND_CHANGE=
# 1 lets the reconciler replace a held generation by terminating this instance — only with a supervisor that restarts it. Production only; default off.
BOS_RECONCILE_HELD_GENERATIONS=
# Where the host writes its boot snapshot. Default: .bos/snapshot under the working directory.
BOS_SNAPSHOT_DIR=
# Console log level: error, warn (default), info or debug. The log file always gets everything; --log-level overrides this.
BOS_LOG_LEVEL=

