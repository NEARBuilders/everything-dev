# FRAMEWORK-OWNED — reconciled from the parent template by `bos upgrade`.
# Local edits are allowed: on the next upgrade the template version wins and your
# copy is backed up under `.bos/sync-backup/`. To make a change permanent, file an
# issue: https://github.com/NEARBuilders/everything-dev/issues

# Generated from configured bos secrets
# Update values as needed for your local environment

# app.host
CORS_ORIGIN=http://localhost:3000

# app.api
# Leave empty to run dev on ephemeral pglite; set a postgres:// URL to opt into compose Postgres.
API_DATABASE_URL=

# apps/upload (standalone upload service — BOS_STORAGE_* are service-side env,
# not composed-plugin secrets; the deploy CLI uses BOS_STORAGE_ORIGIN +
# BOS_STORAGE_API_KEY from its own env/session, see .github/workflows/deploy.yml)
BOS_STORAGE_ENDPOINT=
BOS_STORAGE_BUCKET=
BOS_STORAGE_ACCESS_KEY_ID=
BOS_STORAGE_SECRET_ACCESS_KEY=
BOS_STORAGE_REGION=
BOS_STORAGE_AUTH_ORIGIN=http://localhost:3000
BOS_STORAGE_BOOTSTRAP_API_KEY=
BOS_STORAGE_BOOTSTRAP_ACCOUNT=
BOS_STORAGE_BOOTSTRAP_GATEWAY=

# app.auth
# Leave empty to run dev on ephemeral pglite; set a postgres:// URL to opt into compose Postgres.
AUTH_DATABASE_URL=
BETTER_AUTH_SECRET=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET=
FASTNEAR_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=

# plugins.ai
AI_API_KEY=

