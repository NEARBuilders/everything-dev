# FRAMEWORK-OWNED — reconciled from the parent template by `bos sync` / `bos upgrade`.
# Local edits are allowed: on the next sync the template version wins and your copy
# is backed up under `.bos/sync-backup/`. To make a change permanent, file an issue:
# https://github.com/NEARBuilders/everything-dev/issues

# Generated from configured bos secrets
# Update values as needed for your local environment

# app.host
CORS_ORIGIN=http://localhost:3000

# app.api
API_DATABASE_URL=postgres://everythingdev:everythingdev@localhost:5432/api_db

# apps/upload (standalone upload service — BOS_STORAGE_* are service-side env,
# not composed-plugin secrets; the deploy CLI uses BOS_STORAGE_ORIGIN +
# BOS_STORAGE_API_KEY from its own env/session, see .github/workflows/deploy.yml)
BOS_STORAGE_ENDPOINT=
BOS_STORAGE_BUCKET=
BOS_STORAGE_ACCESS_KEY_ID=
BOS_STORAGE_SECRET_ACCESS_KEY=
BOS_STORAGE_REGION=
BOS_STORAGE_AUTH_ORIGIN=http://localhost:3000
BOS_STORAGE_BOOTSTRAP_API_KEY=
BOS_STORAGE_BOOTSTRAP_ACCOUNT=
BOS_STORAGE_BOOTSTRAP_GATEWAY=

# app.auth
AUTH_DATABASE_URL=postgres://everythingdev:everythingdev@localhost:5433/auth_db
BETTER_AUTH_SECRET=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET=
FASTNEAR_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=

# plugins.ai
AI_API_KEY=

