# FRAMEWORK-OWNED — reconciled from the parent template by `bos upgrade`.
# Local edits are allowed: on the next upgrade the template version wins and your
# copy is backed up under `.bos/sync-backup/`. To make a change permanent, file an
# issue: https://github.com/NEARBuilders/everything-dev/issues

# Generated from configured bos secrets
# Update values as needed for your local environment

# app.host
CORS_ORIGIN=http://localhost:3000

# app.api
# Leave empty for the per-workspace PGlite default (.bos/db/<slug>); set a postgres:// URL for production or shared access.
API_DATABASE_URL=
BETTER_AUTH_SECRET=

# app.auth
# Leave empty for the per-workspace PGlite default (.bos/db/<slug>); set a postgres:// URL for production or shared access.
AUTH_DATABASE_URL=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET=
FASTNEAR_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=
AUTH_BOOTSTRAP_ADMIN_API_KEY=

# plugins.ai
AI_API_KEY=

# plugins.agent-connect
NEAR_INTENTS_AGENT_API_KEY=
AGENT_CONNECT_ENCRYPTION_KEY=

# seed (production `bos seed` only — dev reads seed.auth.ownerAdmin from the authored config)
SEED_OWNER_ADMIN_NEAR_ACCOUNT=
SEED_OWNER_ADMIN_EMAIL=

