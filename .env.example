# Generated from configured bos secrets
# Update values as needed for your local environment

# app.host
CORS_ORIGIN=http://localhost:3000
CSP_STRICT=

# app.api
API_DATABASE_URL=postgres://everythingdev:everythingdev@localhost:5432/api_db
LUMA_CALENDAR_API_KEYS=

# app.auth
AUTH_DATABASE_URL=postgres://everythingdev:everythingdev@localhost:5433/auth_db
BETTER_AUTH_SECRET=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET=
FASTNEAR_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=

# plugins.template
TEMPLATE_DATABASE_URL=postgres://everythingdev:everythingdev@localhost:5432/api_db

# plugins.ai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Bundle storage (ADR 0020) — R2 S3 credentials in production, MinIO in dev
# (docker compose up storage). Unset → in-memory storage (dev only).
# BOS_STORAGE_ENDPOINT=http://localhost:9000
# BOS_STORAGE_REGION=us-east-1
# BOS_STORAGE_BUCKET=bundles
# BOS_STORAGE_ACCESS_KEY_ID=everythingdev
# BOS_STORAGE_SECRET_ACCESS_KEY=everythingdev
# BOS_MAX_BUNDLE_UPLOAD_BYTES=67108864

# CDN deploy flip (ADR 0020) — publish uploads dists to the storage API and
# writes bundle URLs at the CDN origin. Unset → image-native gateway URLs.
# BOS_BUNDLE_CDN_ORIGIN=https://cdn.everything.dev
# BOS_STORAGE_ORIGIN=https://everything.dev
# BOS_STORAGE_API_KEY=

