# Generated from configured bos secrets
# Update values as needed for your local environment

# app.host
CORS_ORIGIN=http://localhost:3000

# app.api
API_DATABASE_URL=postgres://everythingdev:everythingdev@localhost:5432/api_db
# Bundle storage (ADR 0020): S3-compatible R2 credentials. Unset → in-memory
# storage (dev only — `bos deploy`/`bos publish` refuse to publish from it).
# Provisioned by infra/alchemy.run.ts (bucket + cdn domain + S3 token).
BOS_STORAGE_ENDPOINT=
BOS_STORAGE_BUCKET=everything-bundles
BOS_STORAGE_ACCESS_KEY_ID=
BOS_STORAGE_SECRET_ACCESS_KEY=
BOS_STORAGE_REGION=auto

# app.auth
AUTH_DATABASE_URL=postgres://everythingdev:everythingdev@localhost:5433/auth_db
BETTER_AUTH_SECRET=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET=
FASTNEAR_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=

# plugins.template
TEMPLATE_DATABASE_URL=postgres://everythingdev:everythingdev@localhost:5432/api_db

# plugins.proposals
PROPOSALS_DATABASE_URL=postgres://everythingdev:everythingdev@localhost:5432/api_db

# plugins.votes
VOTES_DATABASE_URL=postgres://everythingdev:everythingdev@localhost:5432/api_db

# plugins.ai
AI_API_KEY=

